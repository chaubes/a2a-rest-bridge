# ============================================================
# AgentCart — environment configuration
# Copy this file to .env and fill in real values:
#     cp .env.example .env
# .env is gitignored and must NEVER be committed.
# ============================================================

# ---- LLM provider for the A2A agents ----
# "openai" (default, most reliable structured output) or
# "ollama" (fully local, no cloud key required)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here

# Ollama — used when LLM_PROVIDER=ollama (run `ollama serve` locally)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=agentcart

# ---- OpenTelemetry (MCP + REST tracing) ----
# "console" prints spans to stdout. For production, point OTLP at a collector.
OTEL_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ---- Agent guardrail configuration ----
AGENT_MAX_CHARGE_AMOUNT=50000
AGENT_MAX_RECURSION_LIMIT=15

# ---- REST API base URLs (internal Docker network) ----
ORDER_SERVICE_URL=http://order-service:8080
INVENTORY_SERVICE_URL=http://inventory-service:8081
PAYMENT_SERVICE_URL=http://payment-service:8082
SHIPPING_SERVICE_URL=http://shipping-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# ---- MCP server URLs (internal Docker network) ----
INVENTORY_MCP_URL=http://inventory-mcp:9001
PAYMENT_MCP_URL=http://payment-mcp:9002
SHIPPING_MCP_URL=http://shipping-mcp:9003
ORDER_MCP_URL=http://order-mcp:9004
NOTIFICATION_MCP_URL=http://notification-mcp:9005

# ---- A2A agent URLs (internal Docker network) ----
ORDER_AGENT_URL=http://order-agent:10010
INVENTORY_AGENT_URL=http://inventory-agent:10011
PAYMENT_AGENT_URL=http://payment-agent:10012
SHIPPING_AGENT_URL=http://shipping-agent:10013
NOTIFICATION_AGENT_URL=http://notification-agent:10014

# ---- Frontend (browser-facing, so localhost not the Docker hostname) ----
VITE_ORDER_AGENT_URL=http://localhost:10010
